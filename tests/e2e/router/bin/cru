#!/bin/sh
# Merlin's cru: one crontab line per job, tagged "#<id>#"
TAB=/var/spool/cron/crontabs/root
mkdir -p "${TAB%/*}"
touch "$TAB"
case "$1" in
a)
    id=$2
    shift 2
    grep -v "#$id#\$" "$TAB" >"$TAB.new"
    echo "$* #$id#" >>"$TAB.new"
    mv "$TAB.new" "$TAB"
    ;;
d)
    grep -v "#$2#\$" "$TAB" >"$TAB.new"
    mv "$TAB.new" "$TAB"
    ;;
l) cat "$TAB" ;;
esac
echo root >>"${TAB%/*}/cron.update"
